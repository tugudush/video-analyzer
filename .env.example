# Copy to .env and fill in. Never commit real keys.
#
# The CLI and MCP server read this file from the working directory at startup.
# Real environment variables always win over values in this file.
# A missing or malformed line is ignored; escape sequences are not interpreted.
#
# This file travels with a repository, so it is treated as untrusted: only the
# GEMINI_* and VIDEO_ANALYZER_* keys below are read. Set PATH, FFMPEG_PATH,
# FFPROBE_PATH, and VIDEO_ANALYZER_ALLOW_PRIVATE_HOSTS in the real environment.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Frame budget for extract_frames interval mode (0 = only the 500-frame hard cap)
# VIDEO_ANALYZER_MAX_FRAMES=100
# VIDEO_ANALYZER_DOWNLOAD_MAX_MB=2048
# Per Gemini call: the upload request, each status poll, or a generation request
# VIDEO_ANALYZER_REQUEST_TIMEOUT_MS=300000
# Total budget for uploading the media and waiting until it is ACTIVE
# VIDEO_ANALYZER_UPLOAD_TIMEOUT_MS=600000
# How often to poll the upload status
# VIDEO_ANALYZER_POLL_INTERVAL_MS=2000
# VIDEO_ANALYZER_OUTPUT_DIR=
# VIDEO_ANALYZER_LOG_LEVEL=warn
#
# Environment only (ignored in this file):
#   VIDEO_ANALYZER_ALLOW_PRIVATE_HOSTS=false
#   VIDEO_ANALYZER_CLI_PATH=
#   FFMPEG_PATH=ffmpeg
#   FFPROBE_PATH=ffprobe
