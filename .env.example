# Copy to .env and fill in. Never commit real keys.
#
# The CLI and MCP server read this file from the working directory at startup.
# Real environment variables always win over values in this file.
# A missing or malformed line is ignored; escape sequences are not interpreted.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Frame budget for sampling and extract_frames interval mode (0 = only the 500-frame hard cap)
# VIDEO_ANALYZER_MAX_FRAMES=100
# VIDEO_ANALYZER_DOWNLOAD_MAX_MB=2048
# VIDEO_ANALYZER_OUTPUT_DIR=
# VIDEO_ANALYZER_LOG_LEVEL=warn
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
